# Base URL of the City Sense API, including the version prefix.
# In local Docker development the API is published on the host at :5000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Google OAuth web client ID. Must belong to the same GCP project as the
# API's GOOGLE_CLIENT_ID, otherwise token verification fails.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=google-oauth-client-id.apps.googleusercontent.com
